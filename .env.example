# =================================
# Kiddies Town ECD & Academy
# Enterprise Environment Variables
# =================================
# SECURITY: Never commit .env to version control.
# Rotate all secrets immediately if exposed.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# --- REQUIRED ---

# JWT_SECRET: Signing key for access tokens (min 32 characters).
JWT_SECRET=

# JWT_REFRESH_SECRET: Signing key for refresh tokens (min 32 characters).
JWT_REFRESH_SECRET=

# --- OPTIONAL ---

# DATABASE_URL: Neon PostgreSQL connection string.
# If not set, the app runs in local JSON file mode (for development/demos).
# Get this from the Neon console (starts with postgresql:// or postgres://)
DATABASE_URL=

# PORT: Server port (default: 3000)
PORT=3000

# NODE_ENV: Environment mode (development | production | test)
NODE_ENV=development

# CORS_ORIGIN: Allowed CORS origin (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# GEMINI_API_KEY: Google Gemini AI API key (optional).
# Used by server-side AI PDF generation routes. Keep server-side only.
GEMINI_API_KEY=

# APP_URL: The URL where this app is hosted (used for email links, CORS).
APP_URL=
